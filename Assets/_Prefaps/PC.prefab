  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'To execute the photograph test, you need to bring the doll to the backside
    of the testing chamber room. In there, you will find another chair and a photo
    camera. Place the doll in the chair, and review the taken photo. The photo can
    take a couple of seconds to develop.



    The photo SHOULD simple show what
    is there. If there is a difference between the photo, and reality, it''s an anomaly,
    and the test was unsuccessful.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
