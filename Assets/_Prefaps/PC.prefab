  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Your job is to investigate cursed dolls. You'll run a series of tests
    with each doll. If a test yields abnormal results, mark it with a red check mark.
    If the doll shows no reaction, mark it with a green X. \n\n\nTo do an audio test,
    place the doll in a secured room on a chair and play the audio through the computer.\n\n\nTo
    call the doll's name, interact with the glass in front of the doll while it sits
    in the secured room.\n\n\nTo take a photo, place the doll on the chair in the
    back of the secured room and use the camera. Compare the developed photo with
    reality.\n\n\nTo measure the doll's temperature, use the thermometer while looking
    at the doll. The room's temperature is between 16-25\xB0C. Any other value shown
    from the doll is an anomaly.\n\n\nTo inflict pain, stab the doll with the scissors
    while it's in front of you.\n\n\nThe computer provides help with items and tracks
    your progress. The 'Report' section shows tested dolls and any mistakes. Without
    an active assignment, you can retry any doll, or read its result, which is not
    required.\n\n\nTo start working with a new doll, ring the bell on the table.
    Study the document on the table before testing.\n\n\nAfter completing all tests,
    place the doll in either the OK box or the Dangerous box. If it has shown any
    unusual behavior, even outside of testing, put it in the Dangerous box.\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
